---
import "../styles/global.css";
import Icon from "./Icon.astro";
import { settings as getSettings, publicFile, tr } from "../lib/pb.js";
import { ui, langOf, href, alternate } from "../lib/i18n.js";
import { getImage, Font } from "astro:assets";

interface Props {
  title: string;              // full <title>
  description: string;
  image?: string | null;      // absolute PocketBase URL for og:image
  jsonld?: object[];
  noindex?: boolean;      // 404 page
}
const { title, description, image, jsonld = [], noindex = false } = Astro.props;
const lang = langOf(Astro.url);
const t = ui[lang];
const s = await getSettings();
const siteName = tr(s, "site_name", lang);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const other = alternate(Astro.url);
const [enUrl, arUrl] = (lang === "en" ? [Astro.url.pathname, other] : [other, Astro.url.pathname]).map((p) => new URL(p, Astro.site).href);
const og = image ? new URL((await getImage({ src: image, width: 1200, inferSize: true, format: "jpeg" })).src, Astro.site).href : null;
const logo = publicFile(s, s.logo);
const logoWhite = publicFile(s, s.logo_white);
const pdf = publicFile(s, s.profile_pdf);
const tel = "tel:" + s.phone.replace(/[^+\d]/g, "");
const nav = [[t.home, "/"], [t.about, "/about/"], [t.services, "/services/"], [t.contact, "/contact/"]].map(([label, path]) => [label, href(lang, path)]);
const here = (link: string) => (link === href(lang, "/") ? Astro.url.pathname === link : Astro.url.pathname.startsWith(link));
const socials = [["x", s.x_url, "X (Twitter)"], ["linkedin", s.linkedin_url, "LinkedIn"], ["instagram", s.instagram_url, "Instagram"], ["whatsapp", s.whatsapp_url, "WhatsApp"]].filter(([, u]) => u);

const org = {
  "@context": "https://schema.org", "@type": "GeneralContractor", "@id": Astro.site + "#org",
  name: siteName, alternateName: lang === "ar" ? [s.site_name, s.short_name] : s.short_name, url: Astro.site?.href, logo: new URL(logo, Astro.site).href,
  telephone: s.phone, email: s.email, slogan: tr(s, "tagline", lang),
  address: { "@type": "PostalAddress", addressCountry: "SA" }, areaServed: { "@type": "Country", name: "Saudi Arabia" },
  sameAs: socials.filter(([n]) => n !== "whatsapp").map(([, u]) => u),
};
---
<!doctype html>
<html lang={lang} dir={t.dir}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex ? <meta name="robots" content="noindex" /> : <>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="ar" href={arUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
  </>}
  <link rel="icon" href={publicFile(s, s.favicon)} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={t.ogLocale} />
  <meta property="og:locale:alternate" content={ui[t.switchLang].ogLocale} />
  {og && <meta property="og:image" content={og} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@RightSTD" />
  {lang === "ar" ? <Font cssVariable="--font-arabic" /> : <><Font cssVariable="--font-display" /><Font cssVariable="--font-text" /></>}
  <script type="application/ld+json" set:html={JSON.stringify([org, ...jsonld])} />
</head>
<body>
  <a class="skip" href="#main">{t.skip}</a>
  <header class="site-header">
    <div class="container header-bar">
      <a class="brand" href={href(lang, "/")} aria-label={`${siteName} ${t.homeAria}`}><img src={logo} alt={siteName} width="150" height="80" /></a>
      <nav class="main-nav" aria-label={t.mainNav}>
        <ul>{nav.map(([label, link]) => <li><a href={link} aria-current={here(link) ? "page" : undefined}>{label}</a></li>)}</ul>
      </nav>
      <a class="header-phone" href={tel}><span class="header-phone-icon"><Icon name="phone" size={16} /></span><span><small>{t.callUs}</small><span dir="ltr">{s.phone}</span></span></a>
      <a class="lang-switch" href={other} hreflang={t.switchLang} lang={t.switchLang} title={t.switchTitle}>{t.switchLabel}</a>
      <a class="btn btn-sm" href={pdf} target="_blank" rel="noopener"><Icon name="download" size={16} /> {t.profile}</a>
      <details class="mobile-nav">
        <summary aria-label={t.menu}><Icon name="menu" size={24} /></summary>
        <ul>
          {nav.map(([label, link]) => <li><a href={link} aria-current={here(link) ? "page" : undefined}>{label}</a></li>)}
          <li><a href={pdf} target="_blank" rel="noopener">{t.profileDownload}</a></li>
          <li><a href={tel} dir="ltr">{s.phone}</a></li>
        </ul>
      </details>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer class="site-footer">
    <div class="container">
      <div class="call-card-band">
        <div>
          <p class="call-kicker">{t.callKicker}</p>
          <a class="call-phone" href={tel} dir="ltr">{s.phone}</a>
        </div>
        <a class="btn btn-light" href={href(lang, "/contact/")}>{t.contactUs} <Icon name="arrow" size={16} /></a>
      </div>
    </div>
    <div class="container footer-grid">
      <div>
        <img src={logoWhite} alt={siteName} width="110" height="100" loading="lazy" />
        <p>{tr(s, "tagline", lang)}</p>
      </div>
      <div>
        <h2 class="footer-title">{t.resources}</h2>
        <ul>{nav.map(([label, link]) => <li><a href={link}>{label}</a></li>)}</ul>
      </div>
      <div>
        <h2 class="footer-title">{t.reachUs}</h2>
        <ul class="footer-contact">
          <li><a href={tel}><Icon name="phone" size={15} /> <span dir="ltr">{s.phone}</span></a></li>
          <li><a href={"mailto:" + s.email}><Icon name="mail" size={15} /> {s.email}</a></li>
          <li><Icon name="pin" size={15} /> {tr(s, "location", lang)}</li>
        </ul>
        <ul class="socials">
          {socials.map(([icon, link, label]) => <li><a href={link} target="_blank" rel="noopener" aria-label={label}><Icon name={icon} size={18} /></a></li>)}
        </ul>
      </div>
    </div>
    <p class="copyright">© {new Date().getFullYear()} {siteName}. {t.rights}</p>
  </footer>

  {s.whatsapp_url && <a class="wa-float" href={s.whatsapp_url} target="_blank" rel="noopener" aria-label={t.whatsapp}><Icon name="whatsapp" size={26} /></a>}

  <script>
    const rtl = document.documentElement.dir === "rtl";
    // Tabs: [data-tabs] > [role=tab][aria-controls] + [role=tabpanel]; all panels stay in the HTML for SEO.
    document.querySelectorAll("[data-tabs]").forEach((root) => {
      const tabs = [...root.querySelectorAll('[role="tab"]')];
      const show = (t) => tabs.forEach((x) => {
        const on = x === t;
        x.setAttribute("aria-selected", String(on));
        x.tabIndex = on ? 0 : -1;
        document.getElementById(x.getAttribute("aria-controls")).hidden = !on;
      });
      tabs.forEach((t, i) => {
        t.addEventListener("click", () => show(t));
        t.addEventListener("keydown", (e) => {
          const d = (e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0) * (rtl ? -1 : 1); // RTL: the next tab is on the left
          if (d) { const n = tabs[(i + d + tabs.length) % tabs.length]; show(n); n.focus(); }
        });
      });
    });
    // Links into a tab set ([data-show] = tab id) also select that tab.
    document.querySelectorAll("[data-show]").forEach((a) => a.addEventListener("click", () => document.getElementById(a.dataset.show)?.click()));
    // Carousels: arrow buttons scroll the [data-track] by one card (in RTL "next" scrolls towards the left).
    document.querySelectorAll("[data-carousel]").forEach((root) => {
      const track = root.querySelector("[data-track]");
      root.querySelectorAll("[data-dir]").forEach((b) => b.addEventListener("click", () => {
        const card = track.firstElementChild;
        track.scrollBy({ left: Number(b.dataset.dir) * (rtl ? -1 : 1) * (card ? card.getBoundingClientRect().width + 24 : 300), behavior: "smooth" });
      }));
    });
  </script>
</body>
</html>
