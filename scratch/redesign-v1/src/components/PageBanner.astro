---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { settings, fileUrl } from "../lib/pb.js";

interface Props { title: string; crumbs?: [string, string][] }
const { title, crumbs = [] } = Astro.props;
const s = await settings();
const trail: [string, string][] = [["Home", "/"], ...crumbs, [title, Astro.url.pathname]];
---
<section class="banner">
  <Image class="banner-bg" src={fileUrl(s, s.banner_image)} alt="" inferSize widths={[640, 960, 1440, 1920]} sizes="100vw" quality={55} loading="eager" fetchpriority="high" />
  <div class="container banner-inner">
    <h1>{title}</h1>
    <span class="level-line" aria-hidden="true"></span>
    <nav aria-label="Breadcrumb">
      <ol class="crumbs">
        {trail.map(([label, href], i) => i < trail.length - 1
          ? <li><a href={href}>{label}</a><Icon name="chevrons" size={14} /></li>
          : <li aria-current="page">{label}</li>)}
      </ol>
    </nav>
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  itemListElement: trail.map(([name, href], i) => ({ "@type": "ListItem", position: i + 1, name, item: new URL(href, Astro.site).href })),
})} />
