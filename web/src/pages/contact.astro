---
import { Image } from "astro:assets";
import Layout from "../components/Layout.astro";
import PageBanner from "../components/PageBanner.astro";
import Icon from "../components/Icon.astro";
import { page, settings, fileUrl, tr, trData } from "../lib/pb.js";
import { langOf, ui } from "../lib/i18n.js";

const lang = langOf(Astro.url);
const t = ui[lang];
const [p, s] = await Promise.all([page("contact"), settings()]);
const d = trData(p, lang);
const tel = "tel:" + s.phone.replace(/[^+\d]/g, "");
---
<Layout title={tr(p, "seo_title", lang)} description={tr(p, "seo_description", lang)}>
  <PageBanner title={tr(p, "title", lang)} />
  <section class="section mist">
    <div class="container contact">
      <div class="contact-photo"><Image src={fileUrl(p, p.image)} alt={t.contactAlt} inferSize widths={[400, 640]} sizes="(min-width: 900px) 40vw, 100vw" /></div>
      <div>
        <p class="kicker">{d.kicker}</p>
        <h2>{d.title}</h2>
        <form class="form-card" id="contact-form" method="post" action="/api/collections/messages/records" data-sending={t.sending} data-sent={t.sent} data-failed={t.failed}>
          <h3>{d.form_title}</h3>
          <div class="form-grid">
            <label>{t.firstName}<input name="first_name" autocomplete="given-name" required maxlength="100" /></label>
            <label>{t.lastName}<input name="last_name" autocomplete="family-name" required maxlength="100" /></label>
            <label class="full">{t.email}<input name="email" type="email" autocomplete="email" required dir="ltr" /></label>
            <label class="full">{t.message}<textarea name="message" rows="6" required maxlength="5000" dir="auto"></textarea></label>
            <label class="hp" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
          </div>
          <button class="btn" type="submit">{t.send}</button>
          <p class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
  <section class="contact-info-wrap">
    <iframe class="map" src={d.map_src} title={t.map} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    <div class="contact-info">
      <Image class="contact-info-bg" src={fileUrl(p, p.image2)} alt="" inferSize widths={[640, 960]} sizes="50vw" />
      <h2>{d.info_title}</h2>
      <ul>
        <li><span class="ci-icon"><Icon name="pin" /></span><span><strong>{t.office}</strong>{tr(s, "location", lang)}</span></li>
        <li><span class="ci-icon"><Icon name="phone" /></span><span><strong>{t.phone}</strong><a href={tel} dir="ltr">{s.phone}</a></span></li>
        <li><span class="ci-icon"><Icon name="mail" /></span><span><strong>{t.mail}</strong><a href={"mailto:" + s.email}>{s.email}</a></span></li>
      </ul>
    </div>
  </section>
  <script>
    const form = document.getElementById("contact-form");
    const status = form.querySelector(".form-status");
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = form.querySelector("button");
      btn.disabled = true;
      status.textContent = form.dataset.sending;
      try {
        const res = await fetch(form.action, { method: "POST", body: new FormData(form) });
        if (!res.ok) throw new Error();
        form.reset();
        status.textContent = form.dataset.sent;
      } catch {
        status.textContent = form.dataset.failed;
      } finally {
        btn.disabled = false;
      }
    });
  </script>
</Layout>
