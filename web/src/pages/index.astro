---
import { Image } from "astro:assets";
import Layout from "../components/Layout.astro";
import Icon from "../components/Icon.astro";
import WorkingPlan from "../components/WorkingPlan.astro";
import { page, list, settings, fileUrl, publicFile, excerpt, tr, trData } from "../lib/pb.js";
import { langOf, ui, href } from "../lib/i18n.js";

const lang = langOf(Astro.url);
const t = ui[lang];
const p = await page("home");
const d = trData(p, lang);
const [services, clients, showcase, s] = await Promise.all([list("services"), list("clients"), list("showcase"), settings()]);
const tel = "tel:" + s.phone.replace(/[^+\d]/g, "");
const pdf = publicFile(s, s.profile_pdf);
---
<Layout title={tr(p, "seo_title", lang) || tr(s, "site_name", lang)} description={tr(p, "seo_description", lang)}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="hero-kicker">{d.hero.kicker}</p>
        <h1>{t.heroSr && <span class="sr-only">{t.heroSr}</span>}{d.hero.title1} <span class="hero-h1-2">{d.hero.title2.toLowerCase()}</span></h1>
        <p class="hero-text">{d.hero.text}</p>
        <div class="hero-actions">
          <a class="btn" href={href(lang, d.hero.link)}>{d.hero.button} <Icon name="arrow" size={16} /></a>
          <a class="btn btn-ghost" href={pdf} target="_blank" rel="noopener"><Icon name="download" size={16} /> {t.profile}</a>
        </div>
      </div>
      <div class="hero-media">
        <Image class="hero-img" src={fileUrl(p, p.hero_image)} alt="" inferSize widths={[480, 720, 960, 1200]} sizes="(min-width: 900px) 45vw, 100vw" quality={65} loading="eager" fetchpriority="high" />
        <a class="call-card hero-call" href={tel}><span class="call-icon"><Icon name="phone" size={20} /></span><span><small>{t.callUs}</small><span dir="ltr">{s.phone}</span></span></a>
      </div>
    </div>
    <div class="container">
      <ul class="fields-strip" aria-label={t.ourFields}>
        {showcase.map((f) => <li><a href="#fields" data-show={`tab-${f.id}`}><span>{tr(f, "title", lang)}</span><Icon name="arrow" size={16} /></a></li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container intro">
      <div class="intro-media"><Image class="intro-img" src={fileUrl(p, p.image)} alt={t.introAlt} inferSize widths={[480, 720, 960]} sizes="(min-width: 900px) 45vw, 100vw" /></div>
      <div>
        <p class="kicker">{d.intro.kicker}</p>
        <h2>{d.intro.title}</h2>
        <p>{d.intro.text}</p>
        <ul class="checks">{d.intro.features.map((f) => <li><Icon name="check" size={18} />{f}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section mist" data-carousel>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="kicker">{d.services.kicker}</p>
          <h2>{d.services.title}</h2>
        </div>
        <div class="head-actions">
          <a class="head-link" href={href(lang, "/services/")}>{t.viewAll} <Icon name="arrow" size={16} /></a>
          <button class="carousel-btn" data-dir="-1" aria-label={t.prev}><Icon name="arrow-left" /></button>
          <button class="carousel-btn" data-dir="1" aria-label={t.next}><Icon name="arrow" /></button>
        </div>
      </div>
      <ul class="track" data-track>
        {services.map((sv) => (
          <li class="svc-card">
            <a href={href(lang, `/service/${sv.slug}/`)}>
              <span class="frame"><Image class="svc-img" style={`view-transition-name: svc-${sv.slug}`} src={fileUrl(sv, sv.image)} alt={tr(sv, "title", lang)} inferSize width={360} height={450} fit="cover" widths={[280, 360, 560]} sizes="280px" /></span>
              <h3>{tr(sv, "title", lang)}</h3>
              <p>{excerpt(tr(sv, "body", lang), 12)}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="cta">
    <Image class="cta-bg" src={fileUrl(p, p.image2)} alt="" inferSize widths={[768, 1440, 1920]} sizes="100vw" />
    <div class="container cta-inner">
      <h2><span>{d.cta.outline}</span> {d.cta.title}</h2>
      <a class="btn" href={href(lang, d.cta.link)}>{d.cta.button}</a>
    </div>
  </section>

  <section class="section clients-section">
    <div class="container">
      <div class="section-head"><h2>{d.clients.title}</h2></div>
      <ul class="clients">
        {clients.map((c, i) => {
          const img = <Image src={fileUrl(c, c.logo)} alt={tr(c, "name", lang) || t.clientLogo(i + 1)} inferSize height={80} width={180} fit="contain" />;
          return <li>{c.url ? <a href={c.url} target="_blank" rel="noopener">{img}</a> : img}</li>;
        })}
      </ul>
    </div>
  </section>

  <section class="section showcase" id="fields" data-tabs>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="kicker">{d.showcase.kicker}</p>
          <h2>{d.showcase.title}</h2>
        </div>
      </div>
      <div class="tabs" role="tablist" aria-label={t.ourFields}>
        {showcase.map((f, i) => <button role="tab" id={`tab-${f.id}`} aria-controls={`panel-${f.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>{tr(f, "title", lang)}</button>)}
      </div>
    </div>
    <div class="showcase-band">
      {showcase.map((f, i) => (
        <div class="container showcase-panel" role="tabpanel" id={`panel-${f.id}`} aria-labelledby={`tab-${f.id}`} hidden={i !== 0}>
          {f.images.map((img, j) => (
            <Image class={`arch arch-${j + 1}`} src={fileUrl(f, img)} alt={t.projectAlt(tr(f, "title", lang))} inferSize width={420} height={520} fit="cover" widths={[320, 420, 640]} sizes="(min-width: 900px) 30vw, 45vw" />
          ))}
          <div class="showcase-actions">
            <a class="call-card" href={tel}><span class="call-icon"><Icon name="phone" size={20} /></span><span><small>{t.callUs}</small><span dir="ltr">{s.phone}</span></span></a>
            <a class="btn" href={href(lang, "/contact/")}>{t.moreExplore}</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <WorkingPlan plan={d.plan} />
</Layout>
