---
import { Image } from "astro:assets";
import Layout from "../components/Layout.astro";
import PageBanner from "../components/PageBanner.astro";
import { page, fileUrl } from "../lib/pb.js";

const p = await page("about");
const d = p.data;
---
<Layout title={p.seo_title || "About Us | Right Standard Contracting Company"} description={p.seo_description}>
  <PageBanner title={p.title} />
  <section class="section">
    <div class="container about">
      <div>
        <p class="kicker">{d.kicker}</p>
        <h2>{d.title}</h2>
        <div class="prose letter" set:html={p.body} />
      </div>
      <figure class="founder">
        <div class="founder-arch"><Image src={fileUrl(p, p.image)} alt="Engr. Abdallah Nazir Halawani, Founder & CEO" inferSize widths={[400, 600, 880]} sizes="(min-width: 900px) 40vw, 100vw" loading="eager" /></div>
        <figcaption><strong>Engr. Abdallah Nazir Halawani</strong> Founder &amp; CEO</figcaption>
      </figure>
    </div>
  </section>
  <section class="section mist">
    <div class="container">
      <ul class="pillars">
        {d.tabs.map((t) => <li class="pillar"><h2>{t.title}</h2><div class="prose" set:html={t.html} /></li>)}
      </ul>
    </div>
  </section>
</Layout>
